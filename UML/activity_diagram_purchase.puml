@startuml
title Biểu đồ hoạt động - Thêm giỏ hàng và thanh toán đơn hàng

start

partition "Khách hàng" {
  :Thao tác mua hàng;

  if (Đã đăng nhập?) then (Có)
    if (Là Admin/Staff?) then (Có)
      :Thông báo tài khoản quản trị không được mua hàng;
      :Quay về trang chủ;
      stop
    else (Không)

      if (Chọn thêm vào giỏ hàng?) then (Có)
        :Nhập số lượng sản phẩm;

        if (Số lượng hợp lệ?) then (Có)
          if (Số lượng còn đủ trong kho?) then (Có)
            :Lấy hoặc tạo giỏ hàng;
            :Thêm sản phẩm vào giỏ hàng;
            :Cập nhật số lượng sản phẩm trong giỏ;
            :Đánh dấu sản phẩm được chọn;
            :Thông báo thêm vào giỏ hàng thành công;
            stop
          else (Không)
            :Thông báo số lượng vượt quá tồn kho;
            stop
          endif
        else (Không)
          :Thông báo số lượng không hợp lệ;
          stop
        endif

      else (Không)
        :Chuyển sang quy trình thanh toán;
      endif

    endif
  else (Không)
    :Chuyển đến trang đăng nhập;
    stop
  endif
}

partition "Thanh toán" {
  :Chọn hình thức mua hàng;

  if (Mua từ giỏ hàng?) then (Có)
    :Lấy các sản phẩm đã chọn trong giỏ hàng;

    if (Giỏ hàng có sản phẩm?) then (Có)
      :Tính tổng tiền đơn hàng;
    else (Không)
      :Thông báo giỏ hàng trống;
      stop
    endif

  else (Không)
    :Chọn mua ngay một sản phẩm;
    :Nhập số lượng mua ngay;

    if (Số lượng hợp lệ và còn đủ tồn kho?) then (Có)
      :Tính tổng tiền sản phẩm mua ngay;
    else (Không)
      :Thông báo số lượng không hợp lệ hoặc vượt tồn kho;
      stop
    endif
  endif

  if (Số dư ví đủ để thanh toán?) then (Có)
    :Tạo đơn hàng mới;
    :Tạo chi tiết đơn hàng;
    :Trừ số lượng sản phẩm trong kho;
    :Trừ tiền trong ví khách hàng;

    if (Mua từ giỏ hàng?) then (Có)
      :Xóa sản phẩm đã mua khỏi giỏ hàng;
    else (Không)
      :Không cần cập nhật giỏ hàng;
    endif

    :Cập nhật trạng thái đơn hàng thành đã thanh toán;
    :Thông báo đặt hàng thành công;
    :Xem chi tiết đơn hàng;
    stop

  else (Không)
    :Thông báo số dư ví không đủ;
    stop
  endif
}
@enduml