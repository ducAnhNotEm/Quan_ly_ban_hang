@startuml
title Biểu đồ lớp - Hệ thống quản lý bán hàng Django

skinparam classAttributeIconSize 0
hide empty members

class User <<Django Auth>> {
  - id: int
  - username: string
  - email: string
  - password: string
  - is_staff: bool
}

class Customer {
  - id: int
  - full_name: string
  - phone_number: string
  - address: text?
  - date_of_birth: date?
  - gender: Nam|Nu|Khac
}

class Wallet {
  - id: int
  - balance: bigint
}

class TopUpRequest {
  - id: int
  - amount: bigint
  - note: text?
  - status: PENDING|APPROVED|REJECTED
}

class Product {
  - id: int
  - product_name: string
  - category: string
  - description: text?
  - price: decimal(12,2)
  - discount_percent: decimal(5,2)
  - stock_quantity: int
  - image: ImageField?
  - image_url: URLField?
  - created_at: datetime
}

class ProductImage {
  - id: int
  - image: ImageField
  - created_at: datetime
}

class Cart {
  - id: int
  - created_at: datetime
  - updated_at: datetime
}

class CartItem {
  - id: int
  - quantity: int
  - is_selected: bool
}

class Order {
  - id: int
  - sub_total_amount: decimal(12,2)
  - discount_amount: decimal(12,2)
  - total_amount: decimal(12,2)
  - status: PAID|CANCELLED
  - created_at: datetime
  - is_paid: bool
}

class OrderDetail {
  - id: int
  - quantity: int
  - unit_price: decimal(12,2)
  - discount_percent: decimal(5,2)
  - discount_amount: decimal(12,2)
  - sub_total: decimal(12,2)
}

User "1" -- "0..1" Customer : có hồ sơ
Customer "1" -- "0..1" Wallet : có ví
Customer "1" -- "0..*" TopUpRequest : gửi yêu cầu nạp tiền
Customer "1" -- "0..1" Cart : có giỏ hàng

Cart "1" -- "0..*" CartItem : chứa sản phẩm
Product "1" -- "0..*" CartItem : được thêm vào giỏ

Customer "1" -- "0..*" Order : đặt đơn hàng
Order "1" -- "1..*" OrderDetail : gồm chi tiết đơn
Product "1" -- "0..*" OrderDetail : xuất hiện trong đơn hàng

Product "1" -- "0..*" ProductImage : có ảnh phụ
@enduml